// Config //
configuration {
    modi:                        "drun";
    show-icons:                  true;
    display-drun:                "";
    font: 			 "JetBrainsMono Nerd Font 12";
}

@theme "~/.config/rofi/theme.rasi"


// Main //
window {
    transparency:                "real";
    fullscreen:                  false;
    enabled:                     true;
    cursor:                      "default";
    spacing:                     0em;
    padding:                     0em;
    background-color:            @main-bg;
}
mainbox {
    children: [prompt, entry, listbox];
    enabled:                     true;
    spacing:                     6px;
    padding:                     0em;
    orientation:                 vertical;
    background-color:            transparent;
}


// Lists //
listbox {
    padding:                     0em;
    spacing:                     0em;
    orientation:                 vertical;
    children:                    [ "listview" ];
    background-color:            transparent;
}
listview {
    padding:                     2px;
    spacing:                     0em;
    enabled:                     true;
    columns:                     1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    flow:                        horizontal; 
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               false;
    cursor:                      "default";
    background-color:            transparent;
}


//entry
entry {
    padding: 6px 10px;
    background-color: rgba(255,255,255,0.1);
    border-radius: 6px;
    text-color: #ffffff;
    expand:false;
}

prompt{
	enabled : false;
}



// Elements //
element {
    background-color: transparent;
    text-color: #ffffff;
    padding: 6px 10px;
    spacing: 10px;
    orientation: horizontal;
}

element-icon {
    size: 24px;
    background-color: transparent;
    margin: 0px 10px 0px 0px;
}

element-text {
    enabled: true;
    background-color: transparent;
    text-color: #ffffff;
    highlight: bold;
}

element selected {
    background-color: rgba(100, 100, 100, 0.25);
    border-radius: 6px;
}

element selected.normal {
    background-color: rgba(137, 180, 250, 0.3);
}

listview {
    scrollbar: false;
    lines: 10;
    columns: 1;
    spacing: 8px;
    fixed-height: true;
}

